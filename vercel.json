{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api/knowledge/graph", "destination": "/content/graph-index.json" },
    { "source": "/api/today-candidates", "destination": "/content/today-candidates.json" }
  ],
  "headers": [
    {
      "source": "/content/(.+)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
